# Copia este archivo como .env y completa tus credenciales de Supabase
# (Dashboard de Supabase -> Project Settings -> API)
# La anon key es PÚBLICA: viaja al navegador, no es un secreto.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-aqui

# Opcional: poner true para mostrar los accesos directos de demostración
# también en builds de producción. En desarrollo se muestran siempre.
VITE_MOSTRAR_ACCESOS_DEMO=false

# URL del backend Spring Boot para login JWT, ofertas y postulaciones
VITE_API_URL=http://localhost:8080

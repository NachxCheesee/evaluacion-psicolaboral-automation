# ============================================================================
# Variables de entorno del microservicio AquaChile
# ----------------------------------------------------------------------------
# Copia este archivo como .env (NO lo subas al repositorio) y completa los
# valores reales. Spring Boot carga .env automáticamente mediante
# spring.config.import (ver application.yml). También puedes definirlas en tu
# IDE, en Docker o exportarlas en la terminal.
# ============================================================================

# --- Servidor ---
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Base de datos (Supabase - Session Pooler) ---
# Dashboard -> Connect -> Session pooler
DB_URL=jdbc:postgresql://aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require
DB_USERNAME=postgres.REFERENCIA_DEL_PROYECTO
DB_PASSWORD=TU_PASSWORD_DE_LA_BASE
DB_DRIVER=org.postgresql.Driver
DB_POOL_SIZE=5

# Flyway está desactivado: el script SQL se ejecuta manualmente una vez.
FLYWAY_ENABLED=false
JPA_DDL_AUTO=validate

# --- JWT ---
# Genera un valor largo y aleatorio (mínimo 32 caracteres).
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio-de-64-caracteres
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

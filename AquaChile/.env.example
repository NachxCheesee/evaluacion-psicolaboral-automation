# ============================================================================
# Variables de entorno del microservicio AquaChile
# ----------------------------------------------------------------------------
# Copia este archivo como .env (NO lo subas al repositorio) y completa los
# valores reales. Spring Boot no lee .env automáticamente: define estas
# variables en tu IDE, en Docker o expórtalas en la terminal.
# ============================================================================

# --- Servidor ---
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Base de datos (Parte 2: Session Pooler de Supabase) ---
# Ejemplo de URL: jdbc:postgresql://aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require
DB_URL=jdbc:postgresql://HOST_DEL_POOLER:5432/postgres?sslmode=require
DB_USERNAME=postgres.REFERENCIA_DEL_PROYECTO
DB_PASSWORD=TU_PASSWORD_DE_LA_BASE
DB_DRIVER=org.postgresql.Driver
DB_POOL_SIZE=5

# Flyway se activa en la Parte 2, cuando existan las migraciones.
FLYWAY_ENABLED=false
JPA_DDL_AUTO=none

# --- JWT (Parte 2) ---
# Genera un valor largo y aleatorio (mínimo 32 caracteres).
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7
